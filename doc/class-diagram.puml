@startuml Diagramme de Classes - Système de Réservation de Vols

' Classes
class Client {
    +client_id: UUID
    +nom_client: String
    +email_client: String
    +prenom_client: String
    +getReservations()
}

class Passager {
    +passager_id: UUID
    +nom: String
    +prenom: String
    +getReservations()
}

class Reservation {
    +reservation_id: UUID
    +dateReservation: DateTime
    +getClient()
    +getPassagers()
    +getVol()
}

class Vol {
    +vol_id: Integer
    +numeroVol: String
    +dateDepart: DateTime
    +dateArrivee: DateTime
    +statut: String
    +getAeroportDepart()
    +getAeroportArrivee()
    +getCompagnie()
    +getEscales()
}

class Compagnie {
    +compagnie_id: Integer
    +nom: String
}

class Aeroport {
    +aeroport_id: Integer
    +nom_aeroport: String
}

class Ville {
    +id_ville: Integer
    +nom_ville: String
    +pays_ville: String
}

class Escale {
    +id_escale: Integer
    +heure_arrivee: DateTime
    +heure_depart: DateTime
}

' Relations
' Composition (plus forte, cycle de vie lié)
Vol *-- "0..*" Escale : comporte >

' Agrégations (moins forte, peut exister indépendamment)
Compagnie o-- "1..*" Vol : propose >
Aeroport o-- "1..*" Vol : est départ de >
Aeroport o-- "1..*" Vol : est arrivée de >

' Associations
Client "1" -- "0..*" Reservation : effectue >
Reservation "0..*" -- "1" Passager : concerne >
Reservation "0..*" -- "1" Vol : pour >
Aeroport "1..*" -- "1..*" Ville : dessert >
Escale "0..*" -- "1" Aeroport : se déroule à >

' Notes explicatives
note right of Vol
  Une escale fait partie intégrante du vol
  (d'où la composition)
end note

note right of Reservation
  Un client peut avoir plusieurs réservations
  Une réservation concerne un seul passager et un seul vol
end note

note right of Aeroport
  Un aéroport peut être lié à plusieurs vols
  comme départ ou arrivée
  (d'où l'agrégation)
end note

@enduml 